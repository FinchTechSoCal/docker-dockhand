PUID=1000
PGID=1000
TZ=America/Los_Angeles
APPDATA=/opt/docker
CONNET=dbr0
IMAGE_TAG=latest
DOCKER_GID=998
DATA_DIR=$APPDATA/dockhand/
HOST_DATA_DIR=$APPDATA/dockhand/
SKIP_DF_COLLECTION=false
# https://dockhand.pro/manual/#disable-local-login
DISABLE_LOCAL_LOGIN=false
LOG_LEVEL=info
ENCRYPTION_KEY=YourOwnSecretKey
